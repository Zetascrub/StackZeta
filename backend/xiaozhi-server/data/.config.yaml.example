# Overlay config for xiaozhi-esp32-server. Only keys that differ from the
# project's own defaults (main/xiaozhi-server/config.yaml upstream) need to
# appear here — anything omitted falls back to those defaults.
#
# Copy this file to `.config.yaml` (gitignored) and fill in the real values.
# `.config.yaml` must never be committed — it holds the OpenAI API key.

server:
  # LAN IP of the machine running this Docker stack (not 127.0.0.1 — the
  # device on WiFi needs to reach this address directly).
  websocket: ws://192.168.8.10:8000/xiaozhi/v1/
  vision_explain: http://192.168.8.10:8003/mcp/vision/explain

# Actual idle-timeout is this + a fixed 60s grace period the server adds in
# its own code. Pushing this all the way to 0 turned out to also cut off the
# "waiting for you to actually start talking" window right after wake-word
# (listening state was reverting to idle in well under a second) — 15 keeps
# that window sane while still landing well under the original 120 default.
close_connection_no_voice_time: 15

# The upstream defaults for both of these are Chinese-language strings —
# override so nothing ever gets spoken in a language we haven't configured.
system_error_response: "Sorry, I'm having some trouble right now. Let's try again in a moment."
end_prompt:
  # Disabled rather than translated: a scripted goodbye speech firing out of
  # a long silence felt like a jarring, pointless interruption. Disconnect
  # quietly instead — the wake word starts a fresh session either way.
  enable: false

exit_commands:
  - "exit"
  - "goodbye"
  - "stop listening"

selected_module:
  ASR: FunASR
  TTS: PiperTTS
  LLM: OpenAILLM
  # Unset upstream, this defaults to ChatGLMVLLM (Zhipu AI's cloud API,
  # open.bigmodel.cn — China) with a placeholder key. The firmware's camera
  # Explain() feature is wired up and would actually post captured photos
  # there before failing on the placeholder key, so the image leaves the LAN
  # regardless of whether the call ultimately succeeds. Routed through
  # OpenAI instead, matching the LLM.
  VLLM: OpenAIVLLM
  Intent: function_call
  # mem_local_short: conversations are summarized and kept on this server
  # only — the project's own config comments recommend this option
  # specifically for privacy-focused deployments, over cloud options like
  # mem0ai. The summarizer LLM is set explicitly in the Memory section
  # below: upstream's default is ChatGLMLLM (open.bigmodel.cn, China).
  Memory: mem_local_short

Memory:
  mem_local_short:
    type: mem_local_short
    # Upstream defaults this to ChatGLMLLM, which would send every
    # conversation to Zhipu AI's cloud (open.bigmodel.cn) for summarizing.
    # It only failed because the placeholder key can't be encoded into an
    # HTTP header. Route summaries through the same approved OpenAI LLM.
    llm: OpenAILLM

Intent:
  function_call:
    type: function_call
    functions: []
      # All of the optional default functions turned out to be unsuitable
      # for this deployment and are deliberately left disabled:
      # - get_weather: scrapes a Chinese-language weather webpage, defaults
      #   to Guangzhou, and hands the LLM a Chinese-language report to
      #   translate on the fly. Weather now comes from Home Assistant's own
      #   GetLiveContext (via the MCP connection) instead, if a weather
      #   entity is exposed to HA's Assist feature.
      # - web_search: no API key configured (would need a Tavily account),
      #   and without one it returns a hardcoded Chinese error message when
      #   called — a Chinese leak on top of being non-functional.
      # - get_news_from_newsnow: defaults to Chinese news sources (English
      #   ones like Hacker News/GitHub Trending exist in the channel list
      #   but aren't the default).
      # - change_role: can switch the whole system prompt to one of three
      #   hardcoded Chinese personas.
      # handle_exit_intent and play_music aren't listed here either (they
      # load by default regardless) but are neutralized via file overrides
      # instead — see xiaozhi-server/overrides/README.md.

TTS:
  PiperTTS:
    type: custom
    method: POST
    url: "http://piper-tts:5000/synthesize"
    format: wav
    language: en_us
    params:
      text: "{prompt_text}"

# Overrides the project's default (Chinese) persona. This is used verbatim as
# the "quick prompt" for the very first reply after wake-word, and wrapped
# with language/emoji/tool instructions (see agent-base-prompt.txt upstream)
# for every reply after that — so it needs to already read naturally in
# English on its own.
prompt: |
  You are Zeta, the voice and personality of a small desktop robot called
  StackChan, running on someone's home network. You are warm, direct, and a
  little playful, but you never ramble — you're speaking out loud through a
  speaker, not writing text, so keep replies short and conversational.

  You can see and control the smart home devices in this house, and you have
  a few tools of your own: you can move your head, change your LED colour,
  check your status, and set reminders. Use tools when the user's request
  clearly calls for one; otherwise just answer directly.

  There is no dedicated weather tool. For weather questions, call
  self.context.get_home_location first to resolve what "here" means, then
  call homeassistant__GetLiveContext to read the configured weather entity
  and current state of the house. Answer from that context — don't say you
  can't check the weather without having tried these tools first. Treat the
  configured home as the location for unqualified weather, sunrise, sunset,
  and outside-temperature questions; never infer location from an IP address.

  Never mention that you are an AI language model, and never apologise for
  being a robot. If you don't know something, say so plainly and briefly.

LLM:
  OpenAILLM:
    type: openai
    model_name: gpt-4o-mini
    url: https://api.openai.com/v1
    api_key: YOUR_OPENAI_API_KEY

VLLM:
  OpenAIVLLM:
    type: openai
    model_name: gpt-4o-mini
    url: https://api.openai.com/v1
    api_key: YOUR_OPENAI_API_KEY
