# Copy to .env (gitignored) and fill in real values.

MQTT_HOST=192.168.8.135
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=stackchan/notify

# Used to auto-attach the HA long-lived token when an image_url in a
# notification points back at Home Assistant itself (e.g. a camera snapshot
# proxy URL), so HA automations don't need to construct signed URLs.
HA_BASE_URL=http://192.168.8.135:8123
HA_TOKEN=

# This machine's LAN IP — must match what's baked into the firmware's
# CONFIG_NOTIFY_WS_URL (firmware/sdkconfig.defaults).
PUBLIC_BASE_URL=http://192.168.8.10:8090
