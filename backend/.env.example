# Copy to .env (gitignored) and fill in real values. The example addresses
# (192.168.1.10 = this server, 192.168.1.20 = Home Assistant) are placeholders.

MQTT_HOST=192.168.1.20
MQTT_PORT=1883
# MQTT and Home Assistant credentials can instead be set in the control
# panel's Keys tab (write-only, stored on this server); panel values win.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=stackchan/notify

# Used to auto-attach the HA long-lived token when an image_url in a
# notification points back at Home Assistant itself (e.g. a camera snapshot
# proxy URL), so HA automations don't need to construct signed URLs.
HA_BASE_URL=http://192.168.1.20:8123
HA_TOKEN=

# This machine's LAN IP — must match what's baked into the firmware's
# CONFIG_NOTIFY_WS_URL (firmware/sdkconfig.defaults).
PUBLIC_BASE_URL=http://192.168.1.10:8090

# Shared secret for the device's /ws notification socket. Must match the
# firmware's CONFIG_NOTIFY_WS_TOKEN. If unset, /ws accepts any LAN client,
# which can change device settings (volume, privacy, DND) — set it on any
# network you don't fully trust. Generate one with: openssl rand -hex 32
NOTIFY_WS_TOKEN=

# Control panel (http://<this server>:8090/) sign-in. If unset, a password is
# generated on first start and printed once: docker logs notify-bridge | grep password
CONTROL_PANEL_PASSWORD=
# Extra host names the panel may be opened by (DNS-rebinding guard), comma
# separated, e.g. stackzeta.local. PUBLIC_BASE_URL's host and localhost are
# always allowed.
PANEL_ALLOWED_HOSTS=
