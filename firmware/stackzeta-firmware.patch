+constexpr const char* TAG                      = "Notify";
+constexpr size_t kMaxQueuedNotifications        = 5;
+constexpr int64_t kReconnectIntervalUs          = 5'000'000;   // 5s
+constexpr int64_t kMinGapBetweenNotificationsUs = 4'000'000;   // 4s
+constexpr int64_t kKeepaliveIntervalUs          = 10'000'000;  // 10s
+constexpr int64_t kResleepAfterNotificationUs   = 10'000'000;  // 10s
+constexpr uint32_t kTaskLoopDelayMs             = 200;
+
+struct PendingNotification {
+    std::string id;
+    std::string title;
+    std::string body;
+    std::string image_url;
+    std::string audio_url;
+    std::string category;
+    uint32_t color               = 0xFFAA24;
+    bool urgent                  = false;
+    bool interruption_requested = false;
+};
+
+uint32_t ParseHexColor(const char* value, uint32_t fallback)
+{
+    if (!value || value[0] != '#' || strlen(value) != 7) {
+        return fallback;
+    }
+    char* end = nullptr;
+    unsigned long parsed = strtoul(value + 1, &end, 16);
+    return end && *end == '\0' ? static_cast<uint32_t>(parsed) : fallback;
+}
+
+std::string BuildDisplayText(const PendingNotification& note)
+{
+    if (!note.title.empty() && !note.body.empty()) {
+        return note.title + ": " + note.body;
+    }
+    return note.title.empty() ? note.body : note.title;
+}
+
+std::string UrlHost(const std::string& url)
+{
+    auto scheme = url.find("://");
+    if (scheme == std::string::npos) return {};
+    auto start = scheme + 3;
+    auto end = url.find_first_of("/:?#", start);
+    auto authority = url.substr(start, end == std::string::npos ? std::string::npos : end - start);
+    auto at = authority.rfind('@');
+    if (at != std::string::npos) authority.erase(0, at + 1);
+    if (!authority.empty() && authority.front() == '[') {
+        auto close = authority.find(']');
+        if (close != std::string::npos) return authority.substr(1, close - 1);
+    }
+    auto colon = authority.rfind(':');
+    if (colon != std::string::npos) authority.resize(colon);
+    std::transform(authority.begin(), authority.end(), authority.begin(), ::tolower);
+    while (!authority.empty() && authority.back() == '.') authority.pop_back();
+    return authority;
+}
+
+bool HostMatches(const std::string& host, const std::string& rule)
+{
+    if (rule.rfind("*.", 0) == 0) {
+        const std::string suffix = rule.substr(1);
+        return host.size() > suffix.size() && host.compare(host.size() - suffix.size(), suffix.size(), suffix) == 0;
+    }
+    return host == rule;
+}
+
+// Fetches `url` over HTTP and returns the raw body, or an empty string on
+// failure. Deliberately not using Http::ReadAll(): it waits on a single
+// "body fully complete" condition that never fired against this (aiohttp,
+// keep-alive) server in testing, hanging the whole task indefinitely.
+// Read() in a loop is more robust — each call has its own timeout and
+// returns as soon as any data is available.
+std::string FetchBytes(const std::string& url, int connect_id)
+{
+    if (!NotifyClient::GetInstance().IsNetworkUrlAllowed(url)) {
+        ESP_LOGW(TAG, "Network policy blocked URL: %s", url.c_str());
+        return {};
+    }
+    auto& board  = Board::GetInstance();
+    auto network = board.GetNetwork();
+    auto http    = network->CreateHttp(connect_id);
+    if (!http) {
+        ESP_LOGE(TAG, "Failed to create HTTP client for %s", url.c_str());
+        return {};
+    }
+
+    if (!http->Open("GET", url)) {
+        ESP_LOGE(TAG, "Failed to open URL: %s", url.c_str());
+        return {};
+    }
+
+    int status = http->GetStatusCode();
+    if (status != 200) {
+        ESP_LOGE(TAG, "Fetch failed, status=%d url=%s", status, url.c_str());
+        http->Close();
+        return {};
+    }
+
+    size_t expected = http->GetBodyLength();
+    std::string body;
+    if (expected > 0) {
+        body.reserve(expected);
+    }
+    char buffer[1024];
+    while (true) {
+        int n = http->Read(buffer, sizeof(buffer));
+        if (n < 0) {
+            ESP_LOGE(TAG, "HTTP read error after %d bytes (%s)", (int)body.size(), url.c_str());
+            http->Close();
+            return {};
+        }
+        if (n == 0) {
+            break;  // EOF
+        }
+        body.append(buffer, n);
+        if (expected > 0 && body.size() >= expected) {
+            break;
+        }
+    }
+    http->Close();
+    return body;
+}
+
+// Decodes a JPEG buffer to an LVGL-ready image. Mirrors the pattern already
+// used for camera frames in stackchan_camera.cc.
+std::unique_ptr<LvglImage> DecodeJpeg(const std::string& jpeg_body)
+{
+    if (jpeg_body.empty()) {
+        return nullptr;
+    }
+
+    uint8_t* out_data = nullptr;
+    size_t out_len    = 0;
+    size_t out_width  = 0;
+    size_t out_height = 0;
+    size_t out_stride = 0;
+
+    esp_err_t err = jpeg_to_image(reinterpret_cast<const uint8_t*>(jpeg_body.data()), jpeg_body.size(), &out_data,
+                                   &out_len, &out_width, &out_height, &out_stride);
+    if (err != ESP_OK || !out_data) {
+        ESP_LOGE(TAG, "Failed to decode notification image: %d", (int)err);
+        if (out_data) {
+            heap_caps_free(out_data);
+        }
+        return nullptr;
+    }
+
+    return std::make_unique<LvglAllocatedImage>(out_data, out_len, (int)out_width, (int)out_height, (int)out_stride,
+                                                 LV_COLOR_FORMAT_RGB565);
+}
+
+// Parses a minimal PCM WAV (RIFF/WAVE, 'fmt '+'data' chunks) into 16-bit
+// mono samples, and returns them only if they already match the codec's
+// exact output format. Notification audio used to go through the
+// firmware's Ogg/Opus playback pipeline (Application::PlaySound(), the
+// same path as the built-in chimes), but that vendored decoder reliably
+// corrupted the heap on this dynamically-synthesized speech — reproduced
+// repeatedly in testing, independent of timing. The notify-bridge now
+// resamples to exactly this format server-side so the device can just
+// write raw PCM straight to the codec, bypassing that decoder entirely.
+// Deliberately strict (no on-device resampling) rather than risking
+// another subtle decode bug.
+std::vector<int16_t> ParseMonoPcm16Wav(const std::string& wav, int expected_sample_rate)
+{
+    if (wav.size() < 44 || wav.compare(0, 4, "RIFF") != 0 || wav.compare(8, 4, "WAVE") != 0) {
+        ESP_LOGW(TAG, "Notification audio is not a WAV file");
+        return {};
+    }
+
+    uint16_t audio_format = 0, channels = 0, bits_per_sample = 0;
+    uint32_t sample_rate  = 0;
+    const char* data_ptr  = nullptr;
+    size_t data_len       = 0;
+
+    size_t pos = 12;
+    while (pos + 8 <= wav.size()) {
+        uint32_t chunk_size;
+        memcpy(&chunk_size, wav.data() + pos + 4, sizeof(chunk_size));
+        size_t chunk_data_pos = pos + 8;
+        if (chunk_data_pos + chunk_size > wav.size()) {
+            break;  // truncated chunk
+        }
+
+        if (wav.compare(pos, 4, "fmt ") == 0 && chunk_size >= 16) {
+            memcpy(&audio_format, wav.data() + chunk_data_pos, sizeof(audio_format));
+            memcpy(&channels, wav.data() + chunk_data_pos + 2, sizeof(channels));
+            memcpy(&sample_rate, wav.data() + chunk_data_pos + 4, sizeof(sample_rate));
+            memcpy(&bits_per_sample, wav.data() + chunk_data_pos + 14, sizeof(bits_per_sample));
+        } else if (wav.compare(pos, 4, "data") == 0) {
+            data_ptr = wav.data() + chunk_data_pos;
+            data_len = chunk_size;
+        }
+
+        pos = chunk_data_pos + chunk_size + (chunk_size % 2);  // chunks are word-aligned
+    }
+
+    if (!data_ptr || audio_format != 1 || channels != 1 || bits_per_sample != 16 ||
+        (int)sample_rate != expected_sample_rate) {
+        ESP_LOGW(TAG, "Unsupported notification audio format (fmt=%u ch=%u bits=%u rate=%u), dropping audio",
+                 audio_format, channels, bits_per_sample, (unsigned)sample_rate);
+        return {};
+    }
+
+    std::vector<int16_t> pcm(data_len / sizeof(int16_t));
+    memcpy(pcm.data(), data_ptr, pcm.size() * sizeof(int16_t));
+    return pcm;
+}
