index 0000000..471bc1e
--- /dev/null
+++ b/firmware/main/stackchan/modifiers/listening.h
@@ -0,0 +1,98 @@
+/*
+ * SPDX-FileCopyrightText: 2026 StackZeta
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+#include "../modifiable.h"
+#include "../utils/random.h"
+#include <smooth_ui_toolkit.hpp>
+#include <hal/hal.h>
+#include <cstdint>
+
+namespace stackchan {
+
+// Same subtle-motion tuning as SpeakingModifier's enableMotion path (slow
+// speed, small nod/sway deltas, spaced 1.5-2.5s apart) — kept as its own
+// class rather than shared, since it has no mouth animation to drive and
+// SpeakingModifier's motion logic isn't factored out for reuse elsewhere in
+// this codebase either.
+class ListeningMotionModifier : public Modifier {
+public:
+    ListeningMotionModifier()
+    {
+        _next_motion_tick = GetHAL().millis() + Random::getInstance().getInt(1000, 2000);
+    }
+
+    void _update(Modifiable& stackchan) override
+    {
+        if (!stackchan.hasAvatar()) {
+            return;
+        }
+
+        uint32_t now = GetHAL().millis();
+        if (now >= _next_motion_tick) {
+            _next_motion_tick = now + Random::getInstance().getInt(1500, 2500);
+            perform_subtle_motion(stackchan);
+        }
+    }
+
+private:
+    void perform_subtle_motion(Modifiable& stackchan)
+    {
+        auto& motion = stackchan.motion();
+
+        // Deliberately not gating on motion.isMoving(): for these small,
+        // slow moves the feedback servos' own "moving" status bit was
+        // observed staying stuck true long after the move had visibly
+        // finished (a servo-feedback quirk, not a real ongoing move), which
+        // silently blocked every tick after the first. A fixed cooldown
+        // since our own last commanded move is a more reliable gate for
+        // this purely cosmetic animation.
+        uint32_t now = GetHAL().millis();
+        if (now - _last_move_commanded_at < kMinGapBetweenMovesMs) {
+            return;
+        }
+
+        uitk::Vector2i current_actual_angles = motion.getCurrentAngles();
+
+        if (_need_get_prev_angles) {
+            _prev_angles          = current_actual_angles;
+            _need_get_prev_angles = false;
+        } else {
+            const int32_t threshold = 300;
+            int32_t diff_x          = std::abs(current_actual_angles.x - _prev_angles.x);
+            int32_t diff_y          = std::abs(current_actual_angles.y - _prev_angles.y);
+            if (diff_x > threshold || diff_y > threshold) {
+                _prev_angles = current_actual_angles;
+            }
+        }
+
+        int32_t target_yaw   = _prev_angles.x;
+        int32_t target_pitch = _prev_angles.y;
+
+        int action = Random::getInstance().getInt(0, 10);
+        int speed  = Random::getInstance().getInt(100, 200);
+
+        if (action < 5) {
+            // Slight nod, as if listening attentively
+            target_pitch += Random::getInstance().getInt(-20, 50);
+        } else {
+            // Slight head turn/tilt
+            target_yaw += Random::getInstance().getInt(-40, 40);
+            target_pitch += Random::getInstance().getInt(-20, 20);
+        }
+
+        motion.moveWithSpeed(target_yaw, target_pitch, speed);
+        _last_move_commanded_at = now;
+    }
+
+    static constexpr uint32_t kMinGapBetweenMovesMs = 1200;
+
+    uint32_t _next_motion_tick      = 0;
+    uint32_t _last_move_commanded_at = 0;
+    bool _need_get_prev_angles      = true;
+    uitk::Vector2i _prev_angles;
+};
+
+}  // namespace stackchan
