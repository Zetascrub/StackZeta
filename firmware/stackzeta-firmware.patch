+
+namespace {
+// Register addresses, from the datasheet's Register Set table.
+constexpr uint8_t REG_PS_CONTR     = 0x81;
+constexpr uint8_t REG_PS_LED       = 0x82;
+constexpr uint8_t REG_PS_N_PULSES  = 0x83;
+constexpr uint8_t REG_PS_MEAS_RATE = 0x84;
+constexpr uint8_t REG_PART_ID      = 0x86;
+constexpr uint8_t REG_MANUFAC_ID   = 0x87;
+constexpr uint8_t REG_PS_DATA_0    = 0x8D;
+constexpr uint8_t REG_PS_DATA_1    = 0x8E;
+
+constexpr uint8_t EXPECTED_PART_ID    = 0x92;
+constexpr uint8_t EXPECTED_MANUFAC_ID = 0x05;
+}  // namespace
+
+namespace stackchan_sensors {
+
+Ltr553::Ltr553(i2c_master_bus_handle_t i2c_bus_handle, uint8_t addr)
+{
+    i2c_device_config_t dev_cfg = {
+        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+        .device_address  = addr,
+        .scl_speed_hz    = 400000,
+    };
+    ESP_ERROR_CHECK(i2c_master_bus_add_device(i2c_bus_handle, &dev_cfg, &_i2c_dev));
+}
+
+Ltr553::~Ltr553()
+{
+    if (_i2c_dev) {
+        i2c_master_bus_rm_device(_i2c_dev);
+    }
+}
+
+esp_err_t Ltr553::writeRegister8(uint8_t reg, uint8_t value)
+{
+    uint8_t buf[2] = {reg, value};
+    return i2c_master_transmit(_i2c_dev, buf, sizeof(buf), 1000);
+}
+
+esp_err_t Ltr553::readRegister8(uint8_t reg, uint8_t* out)
+{
+    return i2c_master_transmit_receive(_i2c_dev, &reg, 1, out, 1, 1000);
+}
+
+bool Ltr553::begin()
+{
+    uint8_t part_id = 0, manufac_id = 0;
+    if (readRegister8(REG_PART_ID, &part_id) != ESP_OK || readRegister8(REG_MANUFAC_ID, &manufac_id) != ESP_OK) {
+        ESP_LOGW(TAG, "LTR553 not responding on I2C bus");
+        return false;
+    }
+    if (part_id != EXPECTED_PART_ID || manufac_id != EXPECTED_MANUFAC_ID) {
+        ESP_LOGW(TAG, "Unexpected PART_ID=0x%02X MANUFAC_ID=0x%02X (expected 0x%02X/0x%02X)", part_id, manufac_id,
+                 EXPECTED_PART_ID, EXPECTED_MANUFAC_ID);
+        return false;
+    }
+
+    // LED: keep the power-on default (0x7F = 60kHz, 100% duty, 100mA) —
+    // maximum signal strength, since we want reliable detection over the
+    // stock proximity sensor's normal working range, not to minimize power.
+    writeRegister8(REG_PS_LED, 0x7F);
+    // More LED pulses per measurement than the power-on default (1) for a
+    // stronger, more reliable reading — 8 of the possible 15.
+    writeRegister8(REG_PS_N_PULSES, 0x08);
+    // Measurement rate: 100ms (power-on default) — responsive enough for a
+    // "someone's approaching" wake trigger without polling excessively.
+    writeRegister8(REG_PS_MEAS_RATE, 0x02);
+    // PS_CONTR: gain=00 (X16, power-on default), mode=11 (active).
+    esp_err_t err = writeRegister8(REG_PS_CONTR, 0x03);
+
+    _init = (err == ESP_OK);
+    return _init;
+}
+
+int Ltr553::readProximity()
+{
+    if (!_init) {
+        return -1;
+    }
+    uint8_t data0 = 0, data1 = 0;
+    if (readRegister8(REG_PS_DATA_0, &data0) != ESP_OK || readRegister8(REG_PS_DATA_1, &data1) != ESP_OK) {
+        return -1;
+    }
+    // 11-bit value: 3 bits from the upper byte's low bits, 8 from the lower
+    // byte (bit 7 of the upper byte is a saturation flag, not data).
+    return ((data1 & 0x07) << 8) | data0;
+}
+
+}  // namespace stackchan_sensors
