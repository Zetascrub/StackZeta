new file mode 100644
index 0000000..768a9b7
--- /dev/null
+++ b/firmware/main/hal/board/audio_level.h
@@ -0,0 +1,37 @@
+/*
+ * SPDX-FileCopyrightText: 2026 StackZeta
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+// A minimal shared "latest speaker output level" — deliberately not a
+// uitk::Signal (that's a broadcast-to-many-listeners tool; here there's a
+// single writer and, for now, a single reader polling at its own pace, so a
+// plain atomic is the simpler fit and avoids coupling the low-level codec
+// code to the HAL/signal layer above it).
+namespace stackchan_audio {
+
+inline std::atomic<int32_t>& OutputLevelStorage()
+{
+    static std::atomic<int32_t> level{0};
+    return level;
+}
+
+// Called from CoreS3AudioCodec::Write() with the peak sample magnitude
+// (0..32767) of each chunk actually sent to the speaker.
+inline void UpdateOutputLevel(int32_t peak)
+{
+    OutputLevelStorage().store(peak, std::memory_order_relaxed);
+}
+
+// Called from anything that wants to react to live speaker output, e.g. an
+// audio-reactive mouth animation.
+inline int32_t GetOutputLevel()
+{
+    return OutputLevelStorage().load(std::memory_order_relaxed);
+}
+
+}  // namespace stackchan_audio
