index 0000000..56898b3
--- /dev/null
+++ b/firmware/main/stackchan/proximity/proximity_wake.cpp
@@ -0,0 +1,97 @@
+/*
+ * SPDX-FileCopyrightText: 2026 StackZeta
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include "proximity_wake.h"
+
+#include <application.h>
+#include <esp_log.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include "hal/board/hal_bridge.h"
+#include "hal/drivers/LTR553/LTR553.hpp"
+#include "stackchan/notify/notify_client.h"
+
+namespace stackchan_proximity {
+
+namespace {
+
+constexpr const char* TAG          = "ProxWake";
+constexpr uint32_t kPollIntervalMs = 300;
+
+// Calibrated against real hardware: baseline (nothing nearby) sits stable
+// around 40-49, climbing smoothly to ~200+ as a hand approaches from
+// roughly arm's length and beyond 300 close-up — confirmed triggering a
+// real wake (screen, servos, wake sound) at this threshold on first try.
+constexpr int kNearThreshold = 200;
+constexpr int kFarThreshold  = 120;  // hysteresis: must drop back below this to re-arm
+
+class Impl {
+public:
+    void init()
+    {
+        xTaskCreatePinnedToCore(&Impl::TaskEntry, "proximity_wake", 3072, this, 2, nullptr, 1);
+    }
+
+private:
+    static void TaskEntry(void* param)
+    {
+        static_cast<Impl*>(param)->run();
+    }
+
+    void run()
+    {
+        auto i2c_bus = hal_bridge::board_get_i2c_bus();
+        stackchan_sensors::Ltr553 sensor(i2c_bus);
+        if (!sensor.begin()) {
+            ESP_LOGW(TAG, "Proximity sensor not available, wake-on-approach disabled");
+            return;
+        }
+        ESP_LOGI(TAG, "Proximity sensor ready");
+
+        bool armed = true;  // true = will trigger on the next "near" crossing
+
+        while (true) {
+            vTaskDelay(pdMS_TO_TICKS(kPollIntervalMs));
+
+            int value = sensor.readProximity();
+            if (value < 0) {
+                continue;
+            }
+
+            if (armed && value >= kNearThreshold) {
+                armed = false;
+                if (!notify::NotifyClient::GetInstance().GetPrivacyMode() &&
+                    Application::GetInstance().GetDeviceState() == kDeviceStateIdle) {
+                    ESP_LOGI(TAG, "Proximity wake triggered, value=%d", value);
+                    Application::GetInstance().WakeWordInvoke("proximity");
+                }
+            } else if (!armed && value <= kFarThreshold) {
+                armed = true;
+            }
+        }
+    }
+};
+
+Impl& GetImpl()
+{
+    static Impl impl;
+    return impl;
+}
+
+}  // namespace
+
+ProximityWake& ProximityWake::GetInstance()
+{
+    static ProximityWake instance;
+    return instance;
+}
+
+void ProximityWake::init()
+{
+    GetImpl().init();
+}
+
+}  // namespace stackchan_proximity
diff --git a/firmware/main/stackchan/proximity/proximity_wake.h b/firmware/main/stackchan/proximity/proximity_wake.h
new file mode 100644
index 0000000..dc7f8af
--- /dev/null
+++ b/firmware/main/stackchan/proximity/proximity_wake.h
@@ -0,0 +1,31 @@
+/*
+ * SPDX-FileCopyrightText: 2026 StackZeta
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+namespace stackchan_proximity {
+
+// Wakes the assistant (as if the wake word had been heard) when the
+// LTR-553 proximity sensor detects someone approaching while the device is
+// idle. Runs its own dedicated task — see notify_client.cpp for why: I2C
+// reads are fast, but keeping any polling loop off the shared, LVGL-locked
+// avatar/UI task is the established pattern in this codebase now.
+class ProximityWake {
+public:
+    static ProximityWake& GetInstance();
+
+    // Non-blocking: spawns the polling task and returns immediately. Safe
+    // to call even if no sensor is present — the task detects that and
+    // quietly disables itself.
+    void init();
+
+private:
+    ProximityWake()  = default;
+    ~ProximityWake() = default;
+    ProximityWake(const ProximityWake&)            = delete;
+    ProximityWake& operator=(const ProximityWake&) = delete;
+};
+
+}  // namespace stackchan_proximity
