+++ b/firmware/main/hal/drivers/LTR553/LTR553.hpp
@@ -0,0 +1,47 @@
+/*
+ * SPDX-FileCopyrightText: 2026 StackZeta
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#include <cstdint>
+#include "driver/i2c_master.h"
+#include "esp_err.h"
+
+// Minimal driver for the LTR-553ALS-WA proximity/ambient-light sensor on
+// the CoreS3 (proximity side only — the ALS/light side isn't used here).
+// No existing driver for this chip exists anywhere in this firmware tree
+// (unlike the touch panel, IMU, RTC, etc.), so this is written directly
+// against Lite-On's datasheet (BNS-OD-C131/A4, Rev 1.0).
+//
+// Modeled on the PCF8563_Class driver's structure (same i2c_master API,
+// same board's shared I2C bus).
+namespace stackchan_sensors {
+
+class Ltr553 {
+public:
+    static constexpr uint8_t DEFAULT_ADDRESS = 0x23;
+
+    explicit Ltr553(i2c_master_bus_handle_t i2c_bus_handle, uint8_t addr = DEFAULT_ADDRESS);
+    ~Ltr553();
+
+    // Verifies the sensor responds with the expected PART_ID/MANUFAC_ID,
+    // then powers on the proximity sensor in active mode. Returns false if
+    // the sensor isn't present/responding (safe to ignore proximity
+    // features in that case rather than treating it as fatal).
+    bool begin();
+
+    // Raw proximity ADC reading, 0-2047 (11-bit). Higher = closer. Returns
+    // -1 on I2C read failure.
+    int readProximity();
+
+private:
+    i2c_master_dev_handle_t _i2c_dev = nullptr;
+    bool _init                       = false;
+
+    esp_err_t writeRegister8(uint8_t reg, uint8_t value);
+    esp_err_t readRegister8(uint8_t reg, uint8_t* out);
+};
+
+}  // namespace stackchan_sensors
