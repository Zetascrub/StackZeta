+
+void StackChanAvatarDisplay::EnterPoweredStandby(bool screen_off, bool park_head)
+{
+    auto& stackchan = GetStackChan();
+    DisplayLockGuard lock(this);
+    if (idle_motion_modifier_id_ >= 0) {
+        stackchan.removeModifier(idle_motion_modifier_id_);
+        idle_motion_modifier_id_ = -1;
+    }
+    if (idle_expression_modifier_id_ >= 0) {
+        stackchan.removeModifier(idle_expression_modifier_id_);
+        idle_expression_modifier_id_ = -1;
+    }
+    if (park_head) {
+        stackchan.motion().goHome(300);
+    }
+    if (screen_off) {
+        EnterIdleSleep();
+    }
+}
+
+namespace {
+bool _idle_sleep_active               = false;
+uint8_t _brightness_before_idle_sleep = 100;
+esp_timer_handle_t _idle_sleep_timer  = nullptr;
+constexpr uint32_t kIdleSleepDebounceUs = 2'000'000;  // 2s
+
+// The STANDBY status can fire briefly and transiently during the wake-word
+// handshake, before the real LISTENING status follows moments later —
+// without this debounce, that blip was enough to flash the screen off and
+// straight back on. Only a STANDBY that actually sticks around for 2s
+// results in the screen turning off.
+void _idle_sleep_timer_fired(void*)
+{
+    if (_idle_sleep_active) {
+        return;
+    }
+    _idle_sleep_active             = true;
+    _brightness_before_idle_sleep  = GetHAL().getBackLightBrightness();
+    GetHAL().setBackLightBrightness(0, false);
+}
+
+void _ensure_idle_sleep_timer()
+{
+    if (_idle_sleep_timer) {
+        return;
+    }
+    esp_timer_create_args_t args = {};
+    args.callback                = &_idle_sleep_timer_fired;
+    args.name                    = "idle_sleep";
+    esp_timer_create(&args, &_idle_sleep_timer);
+}
+}  // namespace
+
+void EnterIdleSleep()
+{
+    if (_idle_sleep_active) {
+        return;
+    }
+    _ensure_idle_sleep_timer();
+    esp_timer_stop(_idle_sleep_timer);  // restart the debounce if one's already pending
+    esp_timer_start_once(_idle_sleep_timer, kIdleSleepDebounceUs);
+}
+
+void WakeFromIdleSleep()
+{
+    if (_idle_sleep_timer) {
+        esp_timer_stop(_idle_sleep_timer);  // cancel any pending sleep that hasn't fired yet
+    }
+    if (!_idle_sleep_active) {
+        return;
+    }
+    _idle_sleep_active = false;
+    GetHAL().setBackLightBrightness(_brightness_before_idle_sleep, false);
+}
