diff --git a/firmware/main/stackchan/notify/notify_client.h b/firmware/main/stackchan/notify/notify_client.h
new file mode 100644
index 0000000..5b88694
--- /dev/null
+++ b/firmware/main/stackchan/notify/notify_client.h
@@ -0,0 +1,54 @@
+/*
+ * SPDX-FileCopyrightText: 2026 StackZeta
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#include <string>
+
+namespace notify {
+
+/**
+ * @brief Connects to the stackzeta-notify-bridge over a dedicated WebSocket
+ * (separate from the Xiaozhi voice connection) and displays incoming
+ * Home-Assistant-triggered notifications (title/body text, optionally an
+ * image) on screen. Notifications are held back while the device is
+ * actively listening or speaking, and shown once it's free.
+ */
+class NotifyClient {
+public:
+    static NotifyClient& GetInstance();
+
+    // Call once, after Xiaozhi is up and the avatar display is ready.
+    // Spawns its own task internally — non-blocking, safe to call from
+    // inside a locked UI update loop.
+    void init();
+
+    // Do Not Disturb: while enabled, incoming notifications are dropped
+    // (logged, not queued) rather than shown/spoken once the device is
+    // free. Deliberately not persisted across reboots — a stuck-on DND
+    // that survives a power cycle silently would be a worse footgun than
+    // just having to say it again. Safe to call from any task.
+    void SetDoNotDisturb(bool enabled);
+    bool GetDoNotDisturb() const;
+
+    // Runtime configuration delivered by the local StackZeta control
+    // service. These accessors are safe across the UI, camera and MCP tasks.
+    bool GetPrivacyMode() const;
+    std::string GetHomeContextJson() const;
+    bool IsNetworkUrlAllowed(const std::string& url) const;
+
+    // Queues a short diagnostic event for the control service to log, so
+    // device-side behaviour is visible without a serial console. Bounded
+    // and dropped when disconnected. Safe to call from any task.
+    void ReportEvent(const std::string& event);
+
+private:
+    NotifyClient()  = default;
+    ~NotifyClient() = default;
+    NotifyClient(const NotifyClient&)            = delete;
+    NotifyClient& operator=(const NotifyClient&) = delete;
+};
+
+}  // namespace notify
