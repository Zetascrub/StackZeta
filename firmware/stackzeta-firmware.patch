+
+// Owns a dedicated FreeRTOS task so that WebSocket connect/reconnect (which
+// can legitimately block on network I/O) never stalls the shared avatar/UI
+// update loop in hal.cpp. Only the final `show()` step touches LVGL, and
+// that's done under LvglLockGuard, matching the rest of the codebase.
+class NotifyClientImpl {
+public:
+    NotifyClientImpl()
+    {
+        Settings saved("network_policy", false);
+        _network_policy_enabled = saved.GetInt("enabled", 1) != 0;
+        auto load_list = [&saved](const char* key, std::vector<std::string>& target) {
+            const std::string json = saved.GetString(key);
+            if (json.empty()) return;
+            ArduinoJson::JsonDocument doc;
+            if (ArduinoJson::deserializeJson(doc, json)) return;
+            target.clear();
+            for (ArduinoJson::JsonVariantConst value : doc.as<ArduinoJson::JsonArrayConst>()) {
+                if (value.is<const char*>()) target.emplace_back(value.as<const char*>());
+            }
+        };
+        load_list("allowed_hosts", _allowed_hosts);
+        load_list("blocked_hosts", _blocked_hosts);
+
+        // Persisted so privacy mode holds from boot, before (or without) the
+        // control service reconnecting to push settings.
+        Settings privacy("stackzeta", false);
+        _privacy_mode.store(privacy.GetInt("privacy_mode", 0) != 0, std::memory_order_relaxed);
+    }
+
+    void init()
+    {
+        _url = CONFIG_NOTIFY_WS_URL;
+        if (_url.empty()) {
+            ESP_LOGW(TAG, "CONFIG_NOTIFY_WS_URL is empty, notifications disabled");
+            return;
+        }
+        _gesture_connection = GetHAL().onHeadPetGesture.connect([this](HeadPetGesture gesture) {
+            if (gesture == HeadPetGesture::SwipeForward) {
+                _pending_gesture.store(1, std::memory_order_relaxed);
+            } else if (gesture == HeadPetGesture::SwipeBackward) {
+                _pending_gesture.store(2, std::memory_order_relaxed);
+            }
+        });
+        _last_activity_time = esp_timer_get_time();
+        xTaskCreatePinnedToCore(&NotifyClientImpl::TaskEntry, "notify_client", 6144, this, 3, nullptr, 1);
+    }
+
+    void SetDoNotDisturb(bool enabled)
+    {
+        _do_not_disturb.store(enabled, std::memory_order_relaxed);
+        ESP_LOGI(TAG, "Do Not Disturb %s", enabled ? "enabled" : "disabled");
+    }
+
+    bool GetDoNotDisturb() const
+    {
+        return _do_not_disturb.load(std::memory_order_relaxed);
+    }
+
+    bool GetPrivacyMode() const
+    {
+        return _privacy_mode.load(std::memory_order_relaxed);
+    }
+
+    bool IsNetworkUrlAllowed(const std::string& url) const
+    {
+        std::lock_guard<std::mutex> lock(_settings_mutex);
+        if (!_network_policy_enabled) return true;
+        const std::string host = UrlHost(url);
+        if (host.empty()) return false;
+        for (const auto& rule : _blocked_hosts) if (HostMatches(host, rule)) return false;
+        if (_allowed_hosts.empty()) return true;
+        for (const auto& rule : _allowed_hosts) if (HostMatches(host, rule)) return true;
+        return false;
+    }
+
+    std::string GetHomeContextJson() const
+    {
+        std::lock_guard<std::mutex> lock(_settings_mutex);
+        ArduinoJson::JsonDocument doc;
+        doc["name"]           = _home_name;
+        doc["timezone"]       = _home_timezone;
+        doc["weather_entity"] = _weather_entity;
+        if (_has_coordinates) {
+            doc["latitude"]  = _home_latitude;
+            doc["longitude"] = _home_longitude;
+        }
+        std::string json;
+        ArduinoJson::serializeJson(doc, json);
+        return json;
+    }
+
+private:
+    static void TaskEntry(void* param)
+    {
+        static_cast<NotifyClientImpl*>(param)->run();
+    }
+
+    void run()
+    {
+        connect();
+        while (true) {
+            vTaskDelay(pdMS_TO_TICKS(kTaskLoopDelayMs));
+
+            if (!_websocket || !_websocket->IsConnected()) {
+                int64_t now = esp_timer_get_time();
+                if (now - _last_reconnect_attempt > kReconnectIntervalUs) {
+                    connect();
+                }
+                continue;
+            }
+
+            // IsConnected() only reflects what OnDisconnected has told us —
+            // it doesn't actively notice a peer that closed without a clean
+            // TCP close being surfaced yet. Actively probe instead of trusting
+            // it alone, so a dead connection gets torn down and retried
+            // promptly rather than silently going quiet forever.
+            int64_t now = esp_timer_get_time();
+            if (now - _last_keepalive_sent > kKeepaliveIntervalUs) {
+                _last_keepalive_sent = now;
+                if (!_websocket->Send("{\"type\":\"ping\"}")) {
+                    ESP_LOGW(TAG, "Keepalive send failed, treating connection as dead");
+                    _websocket.reset();
+                    continue;
+                }
+            }
+
+            drainIncoming();
+            sendEvents();
+            processGesture();
+            maybeShowNext();
+            maybeResleep();
+            updatePoweredStandby();
+            updateStateLeds();
+        }
+    }
+
+    void connect()
+    {
+        ESP_LOGI(TAG, "Connecting to notify bridge at %s", _url.c_str());
+        _last_reconnect_attempt = esp_timer_get_time();
+
+        auto& board  = Board::GetInstance();
+        auto network = board.GetNetwork();
+
+        _websocket.reset();
+        _websocket = network->CreateWebSocket(2);
+        if (!_websocket) {
+            ESP_LOGE(TAG, "Failed to create notify websocket");
+            return;
+        }
+
+        _websocket->OnConnected([]() { ESP_LOGI(TAG, "Connected to notify bridge"); });
+        _websocket->OnDisconnected([]() { ESP_LOGI(TAG, "Disconnected from notify bridge"); });
+        _websocket->OnData([this](const char* data, size_t len, bool binary) {
+            if (binary) {
+                return;
+            }
+            std::lock_guard<std::mutex> lock(_mutex);
+            _raw_queue.emplace_back(data, len);
+        });
+
+        if (!_websocket->Connect(_url.c_str())) {
+            ESP_LOGE(TAG, "Failed to connect to notify bridge at %s", _url.c_str());
+        } else {
+            ReportEvent("connected, notify client built " __DATE__ " " __TIME__);
+        }
+        _last_keepalive_sent = esp_timer_get_time();
+    }
+
+    void drainIncoming()
+    {
+        std::deque<std::string> raw;
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            raw.swap(_raw_queue);
+        }
+
+        for (const auto& json_text : raw) {
+            ArduinoJson::JsonDocument doc;
+            auto error = ArduinoJson::deserializeJson(doc, json_text);
+            if (error) {
+                ESP_LOGW(TAG, "Bad notification JSON: %s", error.c_str());
+                continue;
+            }
+
+            const char* type = doc["type"] | "";
+            if (strcmp(type, "settings") == 0) {
+                applySettings(doc["settings"], doc["acknowledge"] | false);
+                continue;
+            }
+            if (strcmp(type, "notification") != 0) {
+                continue;
+            }
+
+            PendingNotification note;
+            note.id        = doc["id"] | "";
+            note.title     = doc["title"] | "";
+            note.body      = doc["body"] | "";
+            note.image_url = doc["image_url"] | "";
+            note.audio_url = doc["audio_url"] | "";
+            note.category  = doc["category"] | "general";
+            note.color     = ParseHexColor(doc["color"] | "", _led_notification);
+            note.urgent    = doc["urgent"] | false;
+
+            if (_do_not_disturb.load(std::memory_order_relaxed)) {
+                ESP_LOGI(TAG, "Do Not Disturb active, dropping notification: %s", note.title.c_str());
+                continue;
+            }
+
+            if (_queue.size() >= kMaxQueuedNotifications) {
+                if (note.urgent) {
+                    ESP_LOGW(TAG, "Notification queue full, urgent alert replacing oldest queued entry");
+                    _queue.pop_back();
+                } else {
+                    ESP_LOGW(TAG, "Notification queue full, dropping incoming routine notification");
+                    continue;
+                }
+            }
+            // Urgent notifications jump ahead of queued routine ones. The
+            // currently displayed notification is never torn down midway;
+            // urgency applies to an active voice conversation and queue
+            // ordering, not to another notification already being shown.
+            if (note.urgent) {
+                _queue.push_front(std::move(note));
+            } else {
+                _queue.push_back(std::move(note));
+            }
+        }
+    }
+
+public:
+    void ReportEvent(const std::string& event)
+    {
+        std::lock_guard<std::mutex> lock(_event_mutex);
+        if (_events.size() >= kMaxQueuedEvents) {
+            _events.pop_front();
+        }
+        _events.emplace_back(std::to_string(esp_timer_get_time() / 1000) + "ms " + event);
+    }
+
+private:
+    void sendEvents()
+    {
+        std::deque<std::string> events;
+        {
+            std::lock_guard<std::mutex> lock(_event_mutex);
+            events.swap(_events);
+        }
+        for (const auto& event : events) {
+            ArduinoJson::JsonDocument doc;
+            doc["type"]  = "device_event";
+            doc["event"] = event;
+            std::string json;
+            ArduinoJson::serializeJson(doc, json);
+            _websocket->Send(json);
+        }
+    }
+
+    bool isDeviceBusy() const
+    {
+        auto state = Application::GetInstance().GetDeviceState();
+        return state == kDeviceStateListening || state == kDeviceStateSpeaking;
+    }
+
+    void maybeShowNext()
+    {
+        if (_queue.empty()) {
+            return;
+        }
+
+        auto& next = _queue.front();
+        if (isDeviceBusy()) {
+            if (next.urgent && !next.interruption_requested) {
+                next.interruption_requested = true;
+                interruptConversation();
+            }
+            return;
+        }
+
+        int64_t now = esp_timer_get_time();
+        if (!next.urgent && now - _last_shown_time < kMinGapBetweenNotificationsUs) {
+            return;
+        }
+
+        PendingNotification note = std::move(_queue.front());
+        _queue.pop_front();
+        _last_shown_time = now;
+        _resleep_pending = true;
+        _notification_led_color = note.urgent ? _led_urgent : note.color;
+        _notification_led_until = now + kResleepAfterNotificationUs;
+
+        wakeFromPoweredStandby();
+        show(note);
+        _last_shown_note = note;
+    }
+
+    void processGesture()
+    {
+        int gesture = _pending_gesture.exchange(0, std::memory_order_relaxed);
+        if (gesture != 0) {
+            wakeFromPoweredStandby();
+        }
+        if (gesture == 1 && !_last_shown_note.id.empty()) {
+            acknowledge(_last_shown_note);
+            ESP_LOGI(TAG, "Acknowledged notification by forward swipe: %s", _last_shown_note.id.c_str());
+        } else if (gesture == 2 && !_last_shown_note.title.empty()) {
+            PendingNotification repeat = _last_shown_note;
+            repeat.id.clear();
+            repeat.urgent = false;
+            repeat.interruption_requested = false;
+            _queue.push_front(std::move(repeat));
+            ESP_LOGI(TAG, "Repeating last notification by backward swipe");
+        }
+    }
+
+    bool playSettingsAcknowledgement()
+    {
+        if (isDeviceBusy()) {
+            ESP_LOGI(TAG, "Settings acknowledgement skipped while audio is busy");
+            return false;
+        }
+
+        auto codec = Board::GetInstance().GetAudioCodec();
+        if (!codec) {
+            ESP_LOGW(TAG, "Cannot play settings acknowledgement: no audio codec");
+            return false;
+        }
+
+        const int sample_rate = codec->output_sample_rate();
+        const int sample_count = sample_rate * 160 / 1000;
+        const int attack_samples = sample_rate * 10 / 1000;
+        const int release_samples = sample_rate * 35 / 1000;
+        constexpr double kPi = 3.14159265358979323846;
+        std::vector<int16_t> pcm(sample_count);
+        for (int i = 0; i < sample_count; ++i) {
+            double envelope = 1.0;
+            if (i < attack_samples) {
+                envelope = static_cast<double>(i) / attack_samples;
+            } else if (i >= sample_count - release_samples) {
+                envelope = static_cast<double>(sample_count - i - 1) / release_samples;
+            }
+            pcm[i] = static_cast<int16_t>(9000.0 * envelope * std::sin(2.0 * kPi * 880.0 * i / sample_rate));
+        }
+
+        const bool queued = Application::GetInstance().GetAudioService().PlayPcm(std::move(pcm));
+        ESP_LOGI(TAG, "Settings acknowledgement beep queued=%d", queued);
+        return queued;
+    }
+
+    void applySettings(ArduinoJson::JsonVariantConst settings, bool acknowledge_update)
+    {
+        auto notifications = settings["notifications"];
+        SetDoNotDisturb(notifications["dnd"] | false);
+
+        {
+            std::lock_guard<std::mutex> lock(_settings_mutex);
+            auto policy = settings["network_policy"];
+            _network_policy_enabled = policy["enabled"] | true;
+            _allowed_hosts.clear();
+            _blocked_hosts.clear();
+            for (ArduinoJson::JsonVariantConst value : policy["allowed_hosts"].as<ArduinoJson::JsonArrayConst>()) {
+                if (value.is<const char*>()) _allowed_hosts.emplace_back(value.as<const char*>());
+            }
+            for (ArduinoJson::JsonVariantConst value : policy["blocked_hosts"].as<ArduinoJson::JsonArrayConst>()) {
+                if (value.is<const char*>()) _blocked_hosts.emplace_back(value.as<const char*>());
+            }
+            Settings saved("network_policy", true);
+            saved.SetInt("enabled", _network_policy_enabled ? 1 : 0);
+            auto save_list = [&saved](const char* key, const std::vector<std::string>& source) {
+                ArduinoJson::JsonDocument doc;
+                auto array = doc.to<ArduinoJson::JsonArray>();
+                for (const auto& value : source) array.add(value);
+                std::string json;
+                ArduinoJson::serializeJson(doc, json);
+                saved.SetString(key, json);
+            };
+            save_list("allowed_hosts", _allowed_hosts);
+            save_list("blocked_hosts", _blocked_hosts);
+        }
+
+        auto device = settings["device"];
+        int volume = device["volume"] | 70;
+        int brightness = device["brightness"] | 80;
+        bool privacy = device["privacy_mode"] | false;
+        _standby_timeout_seconds = std::max(0, device["standby_timeout_seconds"] | 300);
+        _standby_screen_off = device["standby_screen_off"] | true;
+        _standby_leds_off = device["standby_leds_off"] | true;
+        _standby_park_head = device["standby_park_head"] | true;
+        GetHAL().setSpeakerVolume(static_cast<uint8_t>(std::clamp(volume, 0, 100)), true);
+        GetHAL().setBackLightBrightness(static_cast<uint8_t>(std::clamp(brightness, 5, 100)), true);
+
+        auto xiaozhi_config = GetHAL().getXiaozhiConfig();
+        xiaozhi_config.idleShutdownTimeSeconds = device["sleep_timeout_seconds"] | 600;
+        const char* activity = settings["personality"]["activity"] | "balanced";
+        xiaozhi_config.idleRandomMovementLevel = strcmp(activity, "quiet") == 0 ? 0 :
+                                                  strcmp(activity, "lively") == 0 ? 3 : 1;
+        GetHAL().setXiaozhiConfig(xiaozhi_config);
+
+        {
+            std::lock_guard<std::mutex> lock(_settings_mutex);
+            auto location     = settings["location"];
+            _home_name        = location["name"] | "Home";
+            _home_timezone    = location["timezone"] | "Europe/London";
+            _weather_entity   = location["weather_entity"] | "weather.home";
+            _has_coordinates  = !location["latitude"].isNull() && !location["longitude"].isNull();
+            _home_latitude    = location["latitude"] | 0.0;
+            _home_longitude   = location["longitude"] | 0.0;
+        }
+
+        auto led = settings["led"];
+        _led_idle         = ParseHexColor(led["idle"] | "", _led_idle);
+        _led_listening    = ParseHexColor(led["listening"] | "", _led_listening);
+        _led_speaking     = ParseHexColor(led["speaking"] | "", _led_speaking);
+        _led_notification = ParseHexColor(led["notification"] | "", _led_notification);
+        _led_urgent       = ParseHexColor(led["urgent"] | "", _led_urgent);
+        _led_dnd          = ParseHexColor(led["dnd"] | "", _led_dnd);
+        _led_privacy      = ParseHexColor(led["privacy"] | "", _led_privacy);
+        _led_offline      = ParseHexColor(led["offline"] | "", _led_offline);
+
+        bool previous_privacy = _privacy_mode.exchange(privacy, std::memory_order_relaxed);
+        if (previous_privacy != privacy) {
+            Settings saved("stackzeta", true);
+            saved.SetInt("privacy_mode", privacy ? 1 : 0);
+            ReportEvent(std::string("privacy ") + (privacy ? "on" : "off") + " received");
+            Application::GetInstance().ApplyPrivacyMode(privacy);
+        }
+        _last_led_color = UINT32_MAX;
+        _last_activity_time = esp_timer_get_time();
+        wakeFromPoweredStandby();
+        ESP_LOGI(TAG, "Applied control-panel settings (privacy=%d, volume=%d, brightness=%d)", privacy, volume,
+                 brightness);
+        if (acknowledge_update) {
+            const bool played = playSettingsAcknowledgement();
+            if (_websocket) {
+                ArduinoJson::JsonDocument ack;
+                ack["type"] = "settings_ack";
+                ack["played"] = played;
+                std::string json;
+                ArduinoJson::serializeJson(ack, json);
+                _websocket->Send(json);
+            }
+        }
+    }
+
+    void acknowledge(const PendingNotification& note)
+    {
+        if (!_websocket || note.id.empty()) {
+            return;
+        }
+        ArduinoJson::JsonDocument doc;
+        doc["type"] = "notification_ack";
+        doc["id"]   = note.id;
+        std::string json;
+        ArduinoJson::serializeJson(doc, json);
+        _websocket->Send(json);
+    }
+
+    void updateStateLeds()
+    {
+        uint32_t color;
+        int64_t now = esp_timer_get_time();
+        // Privacy wins over standby's LEDs-off: the ring is the only visible
+        // sign that the microphone is blocked, so it must never go dark.
+        if (_privacy_mode.load(std::memory_order_relaxed)) {
+            color = _led_privacy;
+        } else if (_standby_active && _standby_leds_off) {
+            color = 0;
+        } else if (_do_not_disturb.load(std::memory_order_relaxed)) {
+            color = _led_dnd;
+        } else if (now < _notification_led_until) {
+            color = _notification_led_color;
+        } else if (!_websocket || !_websocket->IsConnected()) {
+            color = _led_offline;
+        } else {
+            switch (Application::GetInstance().GetDeviceState()) {
+                case kDeviceStateListening: color = _led_listening; break;
+                case kDeviceStateSpeaking: color = _led_speaking; break;
+                default: color = _led_idle; break;
+            }
+        }
+        if (color == _last_led_color) {
+            return;
+        }
+        _last_led_color = color;
+        auto& stackchan = GetStackChan();
+        stackchan.leftNeonLight().setDuration(0.35f);
+        stackchan.rightNeonLight().setDuration(0.35f);
+        stackchan.leftNeonLight().setColor(color);
+        stackchan.rightNeonLight().setColor(color);
+    }
+
+    void wakeFromPoweredStandby()
+    {
+        _last_activity_time = esp_timer_get_time();
+        if (!_standby_active) {
+            return;
+        }
+        _standby_active = false;
+        WakeFromIdleSleep();
+        _last_led_color = UINT32_MAX;
+        ESP_LOGI(TAG, "Exited powered-on standby");
+    }
+
+    void updatePoweredStandby()
+    {
+        if (_standby_timeout_seconds == 0) {
+            wakeFromPoweredStandby();
+            return;
+        }
+        if (Application::GetInstance().GetDeviceState() != kDeviceStateIdle) {
+            wakeFromPoweredStandby();
+            return;
+        }
+        if (_standby_active || esp_timer_get_time() - _last_activity_time <
+                                   static_cast<int64_t>(_standby_timeout_seconds) * 1'000'000) {
+            return;
+        }
+
+        auto display = dynamic_cast<StackChanAvatarDisplay*>(Board::GetInstance().GetDisplay());
+        if (display) {
+            display->EnterPoweredStandby(_standby_screen_off, _standby_park_head);
+        }
+        _standby_active = true;
+        _last_led_color = UINT32_MAX;
+        ESP_LOGI(TAG, "Entered powered-on standby (screen=%d, leds=%d, park=%d)", _standby_screen_off,
+                 _standby_leds_off, _standby_park_head);
+    }
+
+    void interruptConversation()
+    {
+        ESP_LOGW(TAG, "Urgent notification interrupting active conversation");
+
+        // Application state and protocol actions belong to its main task.
+        // Speaking can be aborted immediately and its buffered audio
+        // discarded. Listening uses the existing event-based stop path so
+        // the server is told cleanly before the state returns to idle.
+        auto& app = Application::GetInstance();
+        app.Schedule([]() {
+            auto& scheduled_app = Application::GetInstance();
+            auto state          = scheduled_app.GetDeviceState();
+            if (state == kDeviceStateSpeaking) {
+                scheduled_app.AbortSpeaking(kAbortReasonNone);
+                scheduled_app.GetAudioService().ResetDecoder();
+                scheduled_app.SetDeviceState(kDeviceStateIdle);
+            } else if (state == kDeviceStateListening) {
+                notify::NotifyClient::GetInstance().ReportEvent("urgent notification stopping listening");
+                scheduled_app.StopListening();
+            }
+        });
+    }
+
+    // Showing a notification calls WakeFromIdleSleep() directly (see
+    // show()) rather than going through the xiaozhi voice state machine, so
+    // nothing else would ever put the screen back to sleep afterward if the
+    // device stays idle — the STANDBY transition that normally triggers
+    // EnterIdleSleep() only fires on real conversation state changes, and a
+    // notification isn't one. Put it back to sleep ourselves once the
+    // notification's had time to be seen/heard and the device is still
+    // idle.
+    void maybeResleep()
+    {
+        if (!_resleep_pending) {
+            return;
+        }
+        if (isDeviceBusy()) {
+            return;  // a real conversation is running; let its own STANDBY transition handle sleep
+        }
+        if (esp_timer_get_time() - _last_shown_time < kResleepAfterNotificationUs) {
+            return;
+        }
+        _resleep_pending = false;
+        EnterIdleSleep();
+    }
+
+    void show(const PendingNotification& note)
+    {
+        // Fetching/decoding is plain network+CPU work; keep it outside the
+        // LVGL lock so a slow HTTP fetch can't stall the UI either.
+        std::unique_ptr<LvglImage> image;
+        if (!note.image_url.empty()) {
+            image = DecodeJpeg(FetchBytes(note.image_url, 3));
+        }
+
+        std::vector<int16_t> pcm;
+        if (!note.audio_url.empty()) {
+            std::string wav = FetchBytes(note.audio_url, 4);
+            if (!wav.empty()) {
+                auto codec = Board::GetInstance().GetAudioCodec();
+                pcm         = ParseMonoPcm16Wav(wav, codec ? codec->output_sample_rate() : 0);
+            }
+        }
+
+        std::string text = BuildDisplayText(note);
+        {
+            // Scoped tightly around just the LVGL/display updates — the
+            // audio write below can block for the full length of the
+            // notification's speech, and holding the LVGL lock for that
+            // long would freeze the avatar/UI the whole time.
+            LvglLockGuard lock;
+
+            auto display = dynamic_cast<LvglDisplay*>(Board::GetInstance().GetDisplay());
+            if (!display) {
+                ESP_LOGE(TAG, "No LVGL display available, dropping notification");
+                return;
+            }
+
+            WakeFromIdleSleep();
+
+            if (!text.empty()) {
+                display->SetChatMessage("assistant", text.c_str());
+            }
+
+            if (image) {
+                display->SetPreviewImage(std::move(image));
+            }
+        }
+
+        if (!pcm.empty()) {
+            // Writes PCM straight to the codec ourselves rather than going
+            // through Application::PlaySound()'s Ogg/Opus decode pipeline
+            // (see ParseMonoPcm16Wav's comment for why). Only safe to do
+            // when the normal voice pipeline isn't also using the codec —
+            // isDeviceBusy() (checked by our caller) rules out an active
+            // conversation, and waiting for the playback queue to drain
+            // here rules out a just-finished one still writing.
+            auto& audio_service = Application::GetInstance().GetAudioService();
+            audio_service.WaitForPlaybackQueueEmpty();
+
+            auto codec = Board::GetInstance().GetAudioCodec();
+            if (codec) {
+                if (!codec->output_enabled()) {
+                    codec->EnableOutput(true);
+                }
+                codec->OutputData(pcm);
+            }
+        }
+
+        ESP_LOGI(TAG, "Showed notification: %s", text.c_str());
+    }
+
+    std::string _url;
+    std::unique_ptr<WebSocket> _websocket;
+    int64_t _last_reconnect_attempt = 0;
+    int64_t _last_keepalive_sent    = 0;
+    int64_t _last_shown_time        = 0;
+    int64_t _last_activity_time     = 0;
+    bool _resleep_pending           = false;
+    bool _standby_active            = false;
+    int _standby_timeout_seconds    = 300;
+    bool _standby_screen_off        = true;
+    bool _standby_leds_off          = true;
+    bool _standby_park_head         = true;
+    int64_t _notification_led_until = 0;
+    uint32_t _notification_led_color = 0xFFAA24;
+    uint32_t _last_led_color         = UINT32_MAX;
+
+    std::atomic<bool> _do_not_disturb{false};
+    std::atomic<bool> _privacy_mode{false};
+    std::atomic<int> _pending_gesture{0};
+    int _gesture_connection = -1;
+
+    uint32_t _led_idle         = 0x00141D;
+    uint32_t _led_listening    = 0x00E5F0;
+    uint32_t _led_speaking     = 0x0A799B;
+    uint32_t _led_notification = 0xFFAA24;
+    uint32_t _led_urgent       = 0xFF5A36;
+    uint32_t _led_dnd          = 0x7B3FB2;
+    uint32_t _led_privacy      = 0xFF0000;
+    uint32_t _led_offline      = 0x303840;
+
+    std::mutex _mutex;
+    std::deque<std::string> _raw_queue;
+    static constexpr size_t kMaxQueuedEvents = 32;
+    std::mutex _event_mutex;
+    std::deque<std::string> _events;
+    std::deque<PendingNotification> _queue;
+    PendingNotification _last_shown_note;
+
+    mutable std::mutex _settings_mutex;
+    std::string _home_name      = "Home";
+    std::string _home_timezone  = "Europe/London";
+    std::string _weather_entity = "weather.home";
+    double _home_latitude       = 0.0;
+    double _home_longitude      = 0.0;
+    bool _has_coordinates       = false;
+    bool _network_policy_enabled = true;
+    // Until the control service pushes its policy: this device's own
+    // backend (from the build config) plus the approved external services.
+    std::vector<std::string> _allowed_hosts{UrlHost(CONFIG_OTA_URL), UrlHost(CONFIG_NOTIFY_WS_URL),
+                                            "api.openai.com", "pool.ntp.org"};
+    std::vector<std::string> _blocked_hosts{"open.bigmodel.cn", "whois.pconline.com.cn", "cn.pool.ntp.org",
+                                            "api.tenclass.net", "47.113.125.164", "ezdata2.m5stack.com",
+                                            "uiflow2.m5stack.com"};
+};
+
+NotifyClient& NotifyClient::GetInstance()
+{
+    static NotifyClient instance;
+    return instance;
+}
+
+namespace {
+NotifyClientImpl& Impl()
+{
+    static NotifyClientImpl impl;
+    return impl;
+}
+}  // namespace
+
+void NotifyClient::init()
+{
+    Impl().init();
+}
+
+void NotifyClient::SetDoNotDisturb(bool enabled)
+{
+    Impl().SetDoNotDisturb(enabled);
+}
